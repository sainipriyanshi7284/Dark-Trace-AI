{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent3Output",
  "description": "Output schema produced by Agent 3 (Contextual Fusion & Triage) for downstream Policy Engine ingestion.",
  "type": "object",
  "required": [
    "incident_id",
    "flow_id",
    "timestamp",
    "verdict",
    "fused_risk_score",
    "confidence",
    "contributing_agents",
    "fusion_status",
    "threat_summary",
    "details",
    "recommended_policy_action",
    "processing_time_ms"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "description": "Unique identifier for the incident."
    },
    "flow_id": {
      "type": "string",
      "description": "Network flow identifier correlated across agents."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the incident."
    },
    "verdict": {
      "type": "string",
      "enum": ["MALICIOUS", "SUSPICIOUS", "BENIGN", "INCONCLUSIVE"]
    },
    "fused_risk_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Calibrated risk score between 0.0 and 1.0."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Overall confidence score between 0.0 and 1.0."
    },
    "contributing_agents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fusion_status": {
      "type": "string",
      "enum": [
        "DUAL_AGENT",
        "SINGLE_AGENT_A1_ONLY",
        "SINGLE_AGENT_A2_ONLY",
        "NO_AGENT_DATA",
        "DEGRADED"
      ]
    },
    "threat_summary": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "recommended_policy_action": {
      "type": "string",
      "enum": ["DROP", "QUARANTINE", "RATE_LIMIT", "ALERT", "LOG_ALLOW"]
    },
    "processing_time_ms": {
      "type": "number",
      "minimum": 0.0
    }
  }
}

