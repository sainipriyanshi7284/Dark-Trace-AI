# Dark-Trace-AI — Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT THE ACTUAL .env FILE (already ignored by .gitignore)

# TinyFish External Threat Intelligence API (FREE TIER ONLY)
# Get your free API key at: https://agent.tinyfish.ai/api-keys
# Free limits: Search 30 req/min (500/hr), Fetch 150 URLs/min (1,000/day)
# Note: Agent API and Browser API are paid endpoints and are strictly prohibited in Dark-Trace-AI
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Threat Intelligence Severity Trigger Threshold (0.0 to 1.0)
TINYFISH_TRIGGER_THRESHOLD=0.75

# Threat Intelligence Cache TTL in seconds (default 3600 = 1 hour)
TINYFISH_CACHE_TTL=3600
